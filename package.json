{
  "name":"sukima-insight",
  "version":"0.1.0",
  "private":true,
  "type":"module",
  "workspaces":["apps/*","services/*","packages/*"],
  "scripts":{
    "dev":"npm --workspace @sukima-insight/dashboard run dev",
